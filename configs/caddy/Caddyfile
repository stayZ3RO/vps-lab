# Caddyfile - VPS Cloud Infrastructure Lab
# Phase: Phase 3 - Reverse Proxy & HTTPS
#
# Public-safe. No secrets in this file.
# ACME_EMAIL and SITE_DOMAIN are supplied from configs/caddy/.env at runtime.
#
# Design goals:
#   - Terminate TLS in one place, automatically (Let's Encrypt + auto-renew)
#   - Reverse-proxy real services at subdomains (status.<domain> etc.)
#   - Emit structured JSON access logs
#   - The apex + www are NOT served here. Cloudflare redirects them to the
#     blog at blog.chrisalorenzo.com. This VPS fronts service subdomains.
{
	# ACME account contact. Set ACME_EMAIL in configs/caddy/.env
	email {$ACME_EMAIL}

	# Do not expose the local admin API.
	admin off

	# Structured access logging for the whole server.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 336h
		}
		format json
		level INFO
	}
}

# ---------------------------------------------------------------------------
# Shared response header policy (applied to each site block that imports it).
# ---------------------------------------------------------------------------
(security_headers) {
	header {
		# HSTS - 1 year, include subdomains. Remove/lower while testing if unsure.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Do not advertise the server software. Deletions are deferred until the
		# response is written, so this also strips the Via header that
		# reverse_proxy adds.
		-Server
		-Via
	}
}

# ---------------------------------------------------------------------------
# status.chrisalorenzo.com -> public Uptime Kuma status page
# ---------------------------------------------------------------------------
# Public status page under the consolidated domain. Public surface only: the
# status page and what it loads (Kuma 1.23.17 routes). Admin is tailnet-only
# (Stage 0b), so the dashboard, settings, socket.io, push, badges and metrics
# answer 404 here.
status.chrisalorenzo.com {
	import security_headers
	# The bare root lands on the status page, never on the Kuma login.
	redir / /status/main 302
	@public path /status/main /api/status-page/main /api/status-page/heartbeat/main /api/status-page/main/manifest.json /assets/* /upload/* /icon.svg /icon.png /icon-192x192.png /icon-512x512.png /favicon.ico /apple-touch-icon.png /apple-touch-icon-precomposed.png /manifest.json /robots.txt
	handle @public {
		reverse_proxy uptime-kuma:3001
	}
	handle {
		respond 404
	}
}

# Old host: permanent redirect to the consolidated domain.
status.{$SITE_DOMAIN} {
	import security_headers
	redir https://status.chrisalorenzo.com{uri} permanent
}

