# ---------------------------------------------------------------------------
# ntfy.chrisalorenzo.com -> self-hosted ntfy (Phase 5). Live since 2026-09-28.
# Setup, validation, and rollback:
# docs/phase-5-monitoring-and-alerts/ntfy-self-hosted-execution-packet.md.
# Caddy serves HTTP/2 and HTTP/3 here by default; WebSockets pass through.
ntfy.chrisalorenzo.com {
	import security_headers
	# ntfy v2.28.0 always sends Access-Control-Allow-Origin "*" (no config key).
	# The web app is off and every client is native or server-side, so no
	# browser needs CORS here. Strip the CORS headers at the edge.
	header -Access-Control-Allow-*
	# ntfy's metrics listener is off; refuse the path at the edge anyway.
	respond /metrics 404
	reverse_proxy ntfy:80 {
		# Send subscriber streams (JSON stream, SSE) without buffering.
		flush_interval -1
	}
}
