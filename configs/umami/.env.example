# Copy to .env on the host and fill in both values. Keep .env out of git.
# Generate POSTGRES_PASSWORD with: openssl rand -hex 32
# Generate APP_SECRET with: openssl rand -base64 32
# POSTGRES_PASSWORD is embedded in DATABASE_URL. Avoid URL-special characters
# or percent-encode them so the connection string parses correctly.
POSTGRES_PASSWORD=
APP_SECRET=
