# Copy to .env on the host (install -m 600 .env.example .env). .env is gitignored.

# Caddy's log directory on the host (bind-mounted into the Caddy container).
CADDY_LOG_DIR=/opt/stayz3ro/proxy/configs/caddy/logs

# Host-only directory holding edge-allowlist.yaml. Outside the repo checkout.
CROWDSEC_LOCAL_DIR=/opt/stayz3ro/crowdsec-local

# Decision 2: set to true to stop Central API registration and signal sharing.
CROWDSEC_DISABLE_ONLINE_API=false

# Added in Stage 2 by the owner-run key step, never typed or committed:
# CROWDSEC_CADDY_BOUNCER_KEY=
# CROWDSEC_FW_BOUNCER_KEY=
# Optional Console enrollment key:
# CROWDSEC_ENROLL_KEY=
